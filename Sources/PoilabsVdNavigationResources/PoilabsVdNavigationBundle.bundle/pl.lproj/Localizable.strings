//MARK: User Guide
"welcome" = "Witamy!";
"welcomeDesc" = "Bardzo się cieszymy, że do nas dołączyłeś.\n\nMamy nadzieję, że nasza aplikacja pomoże Ci aktywnie uczestniczyć w codziennym życiu.\n\nMożesz przejść do następnego etapu i zacząć poznawać aplikację.\n\nAle nie zapominaj! Ta aplikacja nie zastępuje białej laski.";

"howItWorks" = "Jak to działa?";
"howItWorksDesc" = "Używamy czujników Bluetooth do ustalania lokalizacji. Aby móc z nich korzystać, musisz przyznać uprawnienia do lokalizacji i Bluetooth.\n\nUpewnij się, że Bluetooth i usługi lokalizacji są włączone oraz że masz aktywne połączenie z internetem!\n\nDla najlepszego doświadczenia trzymaj telefon przed sobą, równolegle do podłoża.";

"venues" = "Miejsca";
"venuesDesc" = "Dostępne miejsca będą wyświetlane począwszy od najbliższego. Możesz również filtrować dowolny typ miejsca lub wyszukać miejsce za pomocą paska wyszukiwania.";

"poiList" = "Lista lokalizacji";
"poiListDesc" = "Możesz zobaczyć wszystkie dostępne lokalizacje w danym miejscu.\n\nNa przykład: możesz dotrzeć do działów biblioteki, eksponatów w muzeum lub sklepów w centrum handlowym. Jeśli w Twojej lokalizacji dostępna jest treść, możesz jej wysłuchać i wyznaczyć do niej trasę.\n\nMożesz również filtrować listę według kategorii.";

"discoverMode" = "Tryb eksploracji";
"discoverModeDesc" = "Pomaga zrozumieć Twoją lokalizację i otoczenie.\n\nPodczas poruszania się możesz poznać swoją aktualną lokalizację, pobliskie miejsca i punkty.\n\nDodatkowo, jeśli w Twojej lokalizacji dostępna jest treść, pod informacją o kierunku zegarowym pojawi się przycisk. Możesz odsłuchać treść, dotykając dwukrotnie tego przycisku lub informacji o lokalizacji.";

"navigation" = "Nawigacja";
"navigationDesc" = "Po wybraniu punktu przejdziesz do strony szczegółów lokalizacji. Na tej stronie możesz rozpocząć nawigację przyciskiem „Idź tutaj”.\n\nPrzed rozpoczęciem nawigacji warto skonfigurować odpowiednie ustawienia w ustawieniach nawigacji.";

"navigationSteps" = "Kroki nawigacji";
"navigationStepsDesc" = "Po rozpoczęciu nawigacji będziesz otrzymywać ciągłe aktualizacje.\n\nW zależności od ustawienia wybranego w ustawieniach nawigacji, czasem możesz otrzymać ostrzeżenie, że nie jesteś na trasie, nawet jeśli na niej jesteś. Przejdź jeszcze kilka kroków. Jeśli komunikat nadal się pojawia, możesz uzyskać nową trasę, potrząsając telefonem.";

"youAreAllSet" = "Czy jesteś gotowy?";
"youAreAllSetDesc" = "Możesz być teraz nieco zdezorientowany. Ale najlepszym sposobem na naukę czegoś nowego jest praktyka.\n\nZaczynajmy!";
